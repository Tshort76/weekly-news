# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Secrets. Never commit; .env.example is the committed template.
.env

# Generated digests, if anyone points output_dir at the checkout
/digests/
*.mp3

# Editor and OS scratch
.lsp/
.clj-kondo/
.idea/
.vscode/
.DS_Store

# setuptools build artifacts — a stale copy of the package that confuses grep
build/

# config/ is versioned, but not what the app writes beside it: one-generation
# backups from every save, and Google Drive OAuth secrets.
config/*.bak
config/*.recompiled-*
config/credentials.json
config/token.json

# Worktrees made by Claude Code sessions
.claude/
