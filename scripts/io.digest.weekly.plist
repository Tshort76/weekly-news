<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.digest.weekly</string>

  <!-- Edit both paths to match this checkout, then:
       cp scripts/io.digest.weekly.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/io.digest.weekly.plist -->
  <key>WorkingDirectory</key>
  <string>/Users/CHANGEME/Dev/tlong/weekly-news</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/CHANGEME/Dev/tlong/weekly-news/.venv/bin/python</string>
    <string>-m</string>
    <string>digest</string>
    <string>run</string>
    <string>--html</string>
  </array>

  <!-- Friday 07:00 local. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>5</integer>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- No API key here on purpose. This file lives in the repository, so a key
       written into it is a key that gets committed. The run reads it from
       ~/.config/digest/gemini_key, or the Keychain, instead — see the README.

       PATH does have to be set. launchd starts with a bare environment, and
       without these directories html2pdf (--pdf) and ffmpeg (--audio) are not
       found, so those two flags fail quietly while the rest of the run
       succeeds. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/CHANGEME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/digest.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/digest.err.log</string>
</dict>
</plist>
