# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env && chmod 600 .env
#
# Only the provider you actually use needs a key. A local Ollama classifier
# needs none, so a fully local configuration can leave this file empty.

GEMINI_API_KEY=

# Only if digest.toml sets provider = "anthropic":
# ANTHROPIC_API_KEY=
